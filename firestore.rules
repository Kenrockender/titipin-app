rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read/write only their own profile doc.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Catalog data is public read-only from the client for now.
    match /products/{productId} {
      allow read: if true;
    }
    match /trips/{tripId} {
      allow read: if true;
    }
    match /addOns/{addOnId} {
      allow read: if true;
    }
    match /config/{configId} {
      allow read: if true;
    }
  }
}
