# Copy to .env.local and fill in when you connect a real Supabase project.
# The app runs fully on mock data if these are left blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase (Firestore) project config — from Firebase Console > Project Settings > Your apps.
# Safe to expose client-side. The app runs fully on mock data if these are left blank.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firestore database ID, if you created one with a custom ID instead of the
# default "(default)" (Firebase Console > Firestore Database shows this on creation).
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)
FIRESTORE_DATABASE_ID=(default)

# Path to the Firebase Admin service account JSON, used only by local seed scripts
# (scripts/seed-firestore.ts). Never commit the key file itself.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Admin gate — must match the Google account email you'll sign in with.
NEXT_PUBLIC_ADMIN_EMAIL=admin@titipin.id

# WhatsApp Business number for the floating widget (international format, no +)
NEXT_PUBLIC_WA_NUMBER=6281234567890

# Telegram bot for new-request/new-order notifications (from @BotFather).
# TELEGRAM_CHAT_ID: send the bot any message, then fetch it via getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
